me ids are connected.\\n\\t// Example:\\n\\t// \\\"Print to console\\\": {\\n\\t// \\t\\\"scope\\\": \\\"javascript,typescript\\\",\\n\\t// \\t\\\"prefix\\\": \\\"log\\\",\\n\\t// \\t\\\"body\\\": [\\n\\t// \\t\\t\\\"console.log('$1');\\\",\\n\\t// \\t\\t\\\"$2\\\"\\n\\t// \\t],\\n\\t// \\t\\\"description\\\": \\\"Log output to console\\\"\\n\\t// }\\n\\t\\\"New Function Page\\\": {\\n\\t\\t\\\"prefix\\\": \\\"ffp\\\",\\n\\t\\t\\\"scope\\\": \\\"\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"\\\\\\\"use client\\\\\\\"\\\",\\n\\t\\t\\t\\\"import { useTranslation } from \\\\\\\"react-i18next\\\\\\\";\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t\\t\\\"export default function ${1:${TM_DIRECTORY/.*\\\\\\\\\\\\\\\\([^\\\\\\\\\\\\\\\\]*)/${1:/capitalize}${2}/}}() {\\\",\\n\\t\\t\\t\\\"\\\\tconst { t } = useTranslation();\\\",\\n\\t\\t\\t\\\"\\\\treturn (\\\",\\n\\t\\t\\t\\\"\\\\t\\\\t<>\\\\n\\\\t\\\\t</>\\\",\\n\\t\\t\\t\\\"\\\\t);\\\",\\n\\t\\t\\t\\\"}\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"Create export function component\\\"\\n\\t},\\n\\t// Corrected Snippet\\n\\t\\\"New Function Component\\\": {\\n\\t\\t\\\"prefix\\\": \\\"ffc\\\",\\n\\t\\t\\\"scope\\\": \\\"\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"import { useTranslation } from \\\\\\\"react-i18next\\\\\\\";\\\",\\n\\t\\t\\t\\\"export function ${1:${TM_FILENAME_BASE/(?:^|_)([a-zA-Z0-9]+)/${1:/capitalize}/g}}($2) {\\\",\\n\\t\\t\\t\\\"\\\\tconst { t } = useTranslation();\\\",\\n\\t\\t\\t\\\"\\\\treturn (\\\",\\n\\t\\t\\t\\\"\\\\t\\\\t<>\\\",\\n\\t\\t\\t\\\"\\\\t\\\\t\\\",\\n\\t\\t\\t\\\"\\\\t\\\\t</>\\\",\\n\\t\\t\\t\\\"\\\\t)}\\\",\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"Creates a basic export function component with props.\\\"\\n\\t},\\n\\t\\\"Default Map\\\": {\\n\\t\\t\\\"prefix\\\": \\\"mmp\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"{${2}.map((item) => (\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t\\t\\\"                \\\",\\n\\t\\t\\t\\\"))}\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"\\\"\\n\\t}\\n}\"}}","exte